PORT=5000
NODE_ENV=development
DATABASE_SSL=true
# Alternatively use DB_HOST, DB_PORT, DB_NAME, DB_USER, and DB_PASSWORD.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3001,https://elixirr-essence.vercel.app,https://elixirr-essence-vvar.vercel.app,https://elixirr-backend.vercel.app
ADMIN_EMAIL=admin@elixirr-essence.com
ADMIN_PASSWORD=change-this-password
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
